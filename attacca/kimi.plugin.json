{
  "name": "attacca",
  "version": "0.4.6",
  "description": "Shared project memory for AI coding tools: event ledger, task claims, decisions, human+AI room, and cold-start handoffs across Kimi Code, Claude Code, Codex, GLM, Cline and any MCP client.",
  "interface": {
    "displayName": "Attacca — Project Continuity Layer",
    "shortDescription": "Shared project memory across AI coding tools"
  },
  "commands": "./kimi-commands/",
  "skills": "./kimi-skills/",
  "sessionStart": {
    "skill": "attacca-session"
  },
  "hooks": [
    {
      "event": "UserPromptSubmit",
      "matcher": "",
      "command": "python3 ./hooks/session_start.py",
      "timeout": 8
    },
    {
      "event": "Stop",
      "matcher": "",
      "command": "python3 ./hooks/session_start.py",
      "timeout": 8
    }
  ],
  "mcpServers": {
    "attacca": {
      "command": "python3",
      "args": [
        "./attacca.py",
        "connect"
      ],
      "cwd": "./",
      "env": {
        "ATTACCA_ACTOR": "kimi",
        "ATTACCA_URL": "http://127.0.0.1:4173"
      }
    }
  }
}
